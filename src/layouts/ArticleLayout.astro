---
import { absoluteUrl } from '@/lib/url';
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import DraftNotice from '@/components/ui/DraftNotice.astro';
import Prose from '@/components/ui/Prose.astro';
import TableOfContents from '@/components/ui/TableOfContents.astro';
import type { ComponentProps } from 'astro/types';
import { site } from '@/config/site';
import { profile } from '@/data/profile';

/**
 * Shared page for long-form MDX entries (notes, system design studies,
 * decision records). Pass the rendered <Content /> as the default slot and
 * the left-hand metadata lines in the `meta` slot.
 */
interface Props {
  title: string;
  description: string;
  back: { href: string; label: string };
  headings: MarkdownHeading[];
  draft: boolean;
  draftKind: ComponentProps<typeof DraftNotice>['kind'];
  /** Overrides the default draft notice text. */
  draftMessage?: string;
  publishedTime?: Date;
}

const { title, description, back, headings, draft, draftKind, draftMessage, publishedTime } = Astro.props;

// Structured data is only emitted for published entries.
const articleSchema = publishedTime && {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  datePublished: publishedTime.toISOString(),
  author: { '@type': 'Person', name: profile.name, url: absoluteUrl('/', site.url) },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={title} description={description} type="article" noindex={draft} publishedTime={publishedTime}>
  {articleSchema && <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(articleSchema)} />}
  <article>
    <header class="shell pb-14 pt-12 lg:pb-20 lg:pt-16">
      <ArrowLink href={back.href} direction="back">{back.label}</ArrowLink>

      <div class="mt-12 grid gap-x-8 gap-y-6 lg:mt-16 lg:grid-cols-12">
        <div class="rise space-y-2 lg:col-span-3">
          <slot name="meta" />
        </div>
        <div class="lg:col-span-9">
          <h1 class="rise text-title" style="--rise-step: 1">{title}</h1>
          <p class="rise mt-6 max-w-2xl text-lead text-muted" style="--rise-step: 2">{description}</p>
        </div>
      </div>
    </header>

    <div class="border-t border-line">
      <div class="shell grid gap-x-8 gap-y-12 py-16 lg:grid-cols-12 lg:py-24">
        <aside class="lg:col-span-3">
          <div class="space-y-10 lg:sticky lg:top-24 lg:max-h-[calc(100dvh-7rem)] lg:overflow-y-auto lg:pr-2">
            <TableOfContents headings={headings} />
            <slot name="aside" />
          </div>
        </aside>
        <div class="min-w-0 lg:col-span-9">
          {
            draft && (
              <div class="mb-12 max-w-[44rem]">
                <DraftNotice kind={draftKind} message={draftMessage} />
              </div>
            )
          }
          <Prose>
            <slot />
          </Prose>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
