---
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';
---

<button
  type="button"
  class="grid size-10 place-items-center text-muted transition-colors hover:text-fg"
  aria-label="Switch to light theme"
  data-theme-toggle
>
  <Sun class="size-[1.125rem] [[data-theme=light]_&]:hidden" aria-hidden="true" />
  <Moon class="hidden size-[1.125rem] [[data-theme=light]_&]:block" aria-hidden="true" />
</button>

<script>
  type Theme = 'dark' | 'light';

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const current = (): Theme => (root.dataset.theme === 'light' ? 'light' : 'dark');

  const sync = () => {
    const theme = current();
    toggle?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
    themeColor?.setAttribute('content', theme === 'dark' ? '#0b0c0e' : '#f7f6f2');
  };

  toggle?.addEventListener('click', () => {
    const next: Theme = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be unavailable (private mode); the choice then lasts for this page only.
    }
    sync();
  });

  sync();
</script>
