---
import { profile } from '@/data/profile';
import { social } from '@/data/social';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { formatIndex } from '@/lib/format';
---

<section aria-labelledby="hero-heading" class="shell pb-20 pt-16 sm:pt-24 lg:pb-28 lg:pt-32">
  <div class="rise flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
    <p class="label">{profile.positioning.join('  /  ')}</p>
    {
      profile.availability.enabled && (
        <p class="label flex items-center gap-2.5">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
          {profile.availability.label}
        </p>
      )
    }
  </div>

  <h1 id="hero-heading" class="rise mt-10 text-display lg:mt-14" style="--rise-step: 1">
    <span class="block">{profile.headline.primary}</span>
    <span class="block text-muted">{profile.headline.secondary}</span>
  </h1>

  <div class="mt-14 grid gap-x-8 gap-y-14 lg:mt-20 lg:grid-cols-12">
    <div class="rise lg:col-span-7" style="--rise-step: 2">
      <p class="max-w-2xl text-lead text-fg">{profile.statement}</p>
      <p class="mt-5 max-w-xl text-muted">{profile.intro}</p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <ButtonLink href="/contact/">Get in touch</ButtonLink>
        <ArrowLink href="/projects/">Selected work</ArrowLink>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3 border-t border-line pt-6">
        {
          social.map((item) => (
            <li>
              <ArrowLink href={item.href}>{item.label}</ArrowLink>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rise lg:col-span-4 lg:col-start-9" style="--rise-step: 3">
      <h2 class="label">Technical focus</h2>
      <ol class="mt-5 border-t border-line">
        {
          profile.focus.map((item, index) => (
            <li class="flex gap-5 border-b border-line py-3.5 text-[0.9375rem]">
              <span class="label pt-0.5">{formatIndex(index + 1)}</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
