---
import Section from '@/components/layout/Section.astro';
import ProjectRow from '@/components/projects/ProjectRow.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { getProjects } from '@/lib/content';

interface Props {
  index?: string;
}

const projects = await getProjects();
---

<Section
  id="work"
  index={Astro.props.index}
  label="Selected work"
  title="Platforms, services and the infrastructure underneath them."
>
  <div class="border-t border-line">
    {projects.map((project) => <ProjectRow project={project} />)}
  </div>
  <div class="mt-10">
    <ArrowLink href="/projects/">All work</ArrowLink>
  </div>
</Section>
