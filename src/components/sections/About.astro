---
import { philosophy } from '@/data/philosophy';
import Section from '@/components/layout/Section.astro';
import Principles from '@/components/sections/Principles.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';

interface Props {
  index?: string;
}
---

<Section id="about" index={Astro.props.index} label="About" title={philosophy.lead}>
  <div class="grid gap-x-8 gap-y-5 md:grid-cols-9">
    {philosophy.body.map((paragraph) => <p class="text-muted md:col-span-4 md:last:col-start-6">{paragraph}</p>)}
  </div>
  <div class="mt-16">
    <Principles />
  </div>
  <div class="mt-10">
    <ArrowLink href="/about/">More about how I work</ArrowLink>
  </div>
</Section>
