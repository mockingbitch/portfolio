---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Section from '@/components/layout/Section.astro';
import { formatIndex } from '@/lib/format';

interface Props {
  index?: string;
}

const areas = [
  {
    title: 'Architecture playground',
    description: 'Interactive diagrams. Select a component to inspect it, or step through a request, an identity flow or a deployment.',
    href: '/architecture/playground/',
  },
  {
    title: 'System design studies',
    description: 'Design problems worked from requirements and capacity estimates through to failure scenarios and trade-offs.',
    href: '/architecture/#system-design',
  },
  {
    title: 'Engineering deep dives',
    description: 'Concurrency, databases, deployment and observability, explained with code and diagrams.',
    href: '/deep-dives/',
  },
];
---

<Section
  id="architecture"
  index={Astro.props.index}
  label="Architecture"
  title="Diagrams to explore, designs to follow, and the engineering underneath."
>
  <div class="grid gap-px border border-line bg-line md:grid-cols-3" data-reveal-stagger>
    {
      areas.map((area, index) => (
        <article class="group relative flex flex-col bg-bg p-6 sm:p-7" data-spotlight>
          <p class="label">{formatIndex(index + 1)}</p>
          <h3 class="mt-6 text-lg tracking-tight">
            <a
              href={area.href}
              class="outline-none transition-colors duration-150 after:absolute after:inset-0 group-hover:text-accent focus-visible:text-accent focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-accent"
            >
              {area.title}
            </a>
          </h3>
          <p class="mt-3 text-[0.9375rem] text-muted">{area.description}</p>
          <ArrowRight
            class="mt-7 size-4 text-subtle transition duration-200 ease-out-quart group-hover:translate-x-0.5 group-hover:text-accent"
            aria-hidden="true"
          />
        </article>
      ))
    }
  </div>
</Section>
