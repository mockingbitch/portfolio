---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Section from '@/components/layout/Section.astro';
import { formatIndex } from '@/lib/format';

interface Props {
  index?: string;
}

const areas = [
  {
    title: 'Architecture playground',
    description: 'Interactive diagrams. Inspect each component, or step through a request, an identity flow or a deployment.',
    href: '/architecture/playground/',
  },
  {
    title: 'System design studies',
    description: 'Design problems worked from requirements and constraints through to trade-offs and failure modes.',
    href: '/architecture/#system-design',
  },
  {
    title: 'Decision records',
    description: 'Short ADRs: the context, the options considered, the choice, and what it cost.',
    href: '/architecture/#decisions',
  },
];
---

<Section
  id="architecture"
  index={Astro.props.index}
  label="Architecture"
  title="Diagrams to explore, designs to follow, and the decisions behind them."
>
  <div class="grid gap-px border border-line bg-line md:grid-cols-3">
    {
      areas.map((area, index) => (
        <article class="group relative flex flex-col bg-bg p-7 sm:p-8">
          <p class="label">{formatIndex(index + 1)}</p>
          <h3 class="mt-8 text-xl tracking-tight">
            <a
              href={area.href}
              class="outline-none transition-colors duration-150 after:absolute after:inset-0 group-hover:text-accent focus-visible:text-accent focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-accent"
            >
              {area.title}
            </a>
          </h3>
          <p class="mt-3 text-[0.9375rem] text-muted">{area.description}</p>
          <ArrowRight
            class="mt-8 size-4 text-subtle transition duration-200 ease-out-quart group-hover:translate-x-0.5 group-hover:text-accent"
            aria-hidden="true"
          />
        </article>
      ))
    }
  </div>
</Section>
