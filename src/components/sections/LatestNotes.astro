---
import Section from '@/components/layout/Section.astro';
import NoteList from '@/components/articles/NoteList.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { getNotes } from '@/lib/content';

interface Props {
  index?: string;
}

const notes = (await getNotes()).slice(0, 3);
---

<Section
  id="notes"
  index={Astro.props.index}
  label="Technical notes"
  title="Writing on backend engineering, architecture, infrastructure and the decisions between them."
>
  <NoteList notes={notes} as="h3" />
  <div class="mt-10">
    <ArrowLink href="/notes/">All notes</ArrowLink>
  </div>
</Section>
