---
import Section from '@/components/layout/Section.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import type { OpenSourceEntry } from '@/data/openSource';
import { social } from '@/data/social';

interface Props {
  index?: string;
  entries: OpenSourceEntry[];
}

const { index, entries } = Astro.props;
const github = social.find((item) => item.label === 'GitHub');
---

<Section id="open-source" index={index} label="Open source" title="Projects I maintain and work I have contributed upstream.">
  <ul class="border-t border-line">
    {
      entries.map((entry) => (
        <li class="grid gap-x-8 gap-y-2 border-b border-line py-7 md:grid-cols-9">
          <p class="label pt-1.5 md:col-span-2">{entry.role}</p>
          <div class="md:col-span-7">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <h3 class="font-mono text-lg leading-snug tracking-tight">
                {entry.url ? (
                  <a href={entry.url} rel="noopener" class="link">
                    {entry.project}
                  </a>
                ) : (
                  entry.project
                )}
              </h3>
              {entry.placeholder && <DraftBadge label="Placeholder" />}
            </div>
            <p class:list={['mt-2 max-w-2xl text-[0.9375rem]', entry.placeholder ? 'text-subtle' : 'text-muted']}>
              {entry.description}
            </p>
            {entry.contributions && entry.contributions.length > 0 && (
              <ul class="mt-4 space-y-1.5 text-[0.9375rem] text-muted">
                {entry.contributions.map((contribution) => (
                  <li class="flex gap-3">
                    <span class="text-subtle" aria-hidden="true">
                      —
                    </span>
                    {contribution.url ? (
                      <a href={contribution.url} rel="noopener" class="link">
                        {contribution.title}
                      </a>
                    ) : (
                      <span>{contribution.title}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {entry.language && <p class="label mt-4">{entry.language}</p>}
          </div>
        </li>
      ))
    }
  </ul>
  {
    github && (
      <div class="mt-10">
        <ArrowLink href={github.href}>More on GitHub</ArrowLink>
      </div>
    )
  }
</Section>
