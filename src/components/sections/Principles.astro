---
import { philosophy } from '@/data/philosophy';
import { formatIndex } from '@/lib/format';
---

<ol class="border-t border-line">
  {
    philosophy.principles.map((principle, index) => (
      <li class="grid gap-x-8 gap-y-2 border-b border-line py-7 md:grid-cols-9">
        <span class="label pt-1 md:col-span-1">{formatIndex(index + 1)}</span>
        <h3 class="text-lg leading-snug tracking-tight md:col-span-3">{principle.title}</h3>
        <p class="text-muted md:col-span-5">{principle.description}</p>
      </li>
    ))
  }
</ol>
