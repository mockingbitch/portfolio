---
import { formatIndex } from '@/lib/format';

/** Numbered list of titled statements: principles, interests, working agreements. */
interface Props {
  items: readonly { title: string; description: string }[];
}
---

<ol class="border-t border-line" data-reveal-stagger>
  {
    Astro.props.items.map((item, index) => (
      <li class="grid gap-x-8 gap-y-2 border-b border-line py-7 md:grid-cols-9">
        <span class="label pt-1 md:col-span-1">{formatIndex(index + 1)}</span>
        <h3 class="text-lg leading-snug tracking-tight md:col-span-3">{item.title}</h3>
        <p class="text-muted md:col-span-5">{item.description}</p>
      </li>
    ))
  }
</ol>
