---
import FileText from '@lucide/astro/icons/file-text';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import { profile } from '@/data/profile';

/** Closing block for listing pages: one line and the two next steps. */
interface Props {
  title?: string;
  lead?: string;
}

const {
  title = 'Want the detail behind any of these systems?',
  lead = 'The resume has the full history. For architecture, trade-offs and what I would do differently, ask me directly.',
} = Astro.props;
---

<section aria-labelledby="cta-heading" class="border-t border-line">
  <div class="shell grid gap-x-8 gap-y-8 py-16 lg:grid-cols-12 lg:py-24">
    <div class="lg:col-span-7 lg:col-start-4">
      <h2 id="cta-heading" class="text-heading" data-reveal>{title}</h2>
      <p class="mt-5 max-w-xl text-muted">{lead}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          profile.resume.href && (
            <ButtonLink href={profile.resume.href} plain>
              <FileText class="size-4" aria-hidden="true" />
              View resume
            </ButtonLink>
          )
        }
        <ButtonLink href="/contact/" variant={profile.resume.href ? 'secondary' : 'primary'}>Get in touch</ButtonLink>
      </div>
    </div>
  </div>
</section>
