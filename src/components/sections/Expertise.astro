---
import { expertise } from '@/data/expertise';
import Section from '@/components/layout/Section.astro';
import { formatIndex } from '@/lib/format';

interface Props {
  index?: string;
}
---

<Section
  id="expertise"
  index={Astro.props.index}
  label="Expertise"
  title="Four areas, one continuous practice — from the API contract down to the cluster it runs on."
>
  <div class="grid gap-px border border-line bg-line md:grid-cols-2">
    {
      expertise.map((area, index) => (
        <article class="flex flex-col bg-bg p-7 sm:p-9">
          <p class="label">{formatIndex(index + 1)}</p>
          <h3 class="mt-8 text-xl tracking-tight">{area.title}</h3>
          <p class="mt-3 text-[0.9375rem] text-muted">{area.summary}</p>
          <ul class="mt-8 grid grid-cols-2 gap-x-6 border-t border-line pt-5 font-mono text-[0.8125rem] text-muted">
            {area.items.map((item) => (
              <li class="py-1.5">{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
