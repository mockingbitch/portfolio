---
import DraftBadge from '@/components/ui/DraftBadge.astro';
import type { ExperienceEntry } from '@/data/experience';

interface Props {
  entries: ExperienceEntry[];
  /** Show the highlights under each role. */
  detailed?: boolean;
}

const { entries, detailed = false } = Astro.props;
---

<ol class="border-t border-line" data-reveal-stagger>
  {
    entries.map((entry) => (
      <li class="grid gap-x-8 gap-y-2 border-b border-line py-7 md:grid-cols-9">
        <p class="label pt-1.5 md:col-span-2">{entry.period}</p>
        <div class="md:col-span-7">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <h3 class="text-xl leading-snug tracking-tight">{entry.role}</h3>
            {entry.placeholder && <DraftBadge label="Placeholder" />}
          </div>
          <p class="label mt-2">{entry.organisation}</p>
          <p class:list={['mt-3 max-w-2xl text-[0.9375rem]', entry.placeholder ? 'text-subtle' : 'text-muted']}>
            {entry.summary}
          </p>
          {detailed && entry.highlights && entry.highlights.length > 0 && (
            <ul class:list={['mt-4 space-y-1.5 text-[0.9375rem]', entry.placeholder ? 'text-subtle' : 'text-muted']}>
              {entry.highlights.map((highlight) => (
                <li class="flex gap-3">
                  <span class="text-subtle" aria-hidden="true">
                    —
                  </span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
