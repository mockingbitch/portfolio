---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Tag from '@/components/ui/Tag.astro';
import { projectFeaturedTech, projectHasPage, projectPath, type Project } from '@/lib/content';
import { formatIndex } from '@/lib/format';

interface Props {
  project: Project;
  /** Heading level of the project title. */
  as?: 'h2' | 'h3';
}

const { project, as: Heading = 'h3' } = Astro.props;
const { data } = project;

// A draft is listed but not linked, unless its page exists in this build (development).
const linked = projectHasPage(project);
const isDraft = data.status === 'draft';
const tags = projectFeaturedTech(project);
const meta = [data.role, data.period].filter((item): item is string => Boolean(item));
const impact = data.impact ?? [];
---

<article
  class:list={[
    'relative grid gap-x-8 gap-y-5 border-b border-line py-9 md:grid-cols-9 lg:py-10',
    linked && 'group',
  ]}
  data-project
  data-group={data.group}
>
  <p class="label hidden pt-2 md:col-span-1 md:block">{formatIndex(data.order)}</p>

  <div class:list={[data.coverDiagram ? 'md:col-span-5' : 'md:col-span-8']}>
    <p class="label mb-3 text-accent">{data.category}</p>

    <div class="flex items-start gap-4">
      <Heading class="text-2xl tracking-tight sm:text-[1.75rem]">
        {
          linked ? (
            <a
              href={projectPath(project)}
              class="outline-none transition-colors duration-150 after:absolute after:inset-0 group-hover:text-accent focus-visible:text-accent focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-accent"
            >
              {data.title}
            </a>
          ) : (
            data.title
          )
        }
      </Heading>
      {
        linked && (
          <ArrowUpRight
            class="ml-auto mt-1.5 size-5 shrink-0 text-subtle transition duration-200 ease-out-quart group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
            aria-hidden="true"
          />
        )
      }
    </div>

    {
      meta.length > 0 && (
        <p class="label mt-2.5 flex flex-wrap gap-x-2 gap-y-1">
          {meta.map((item, index) => (
            <span>
              {index > 0 && <span aria-hidden="true">· </span>}
              {item}
            </span>
          ))}
        </p>
      )
    }
    {
      /* Impact sits on its own line so a separator never dangles at a line break. */
      impact.length > 0 && (
        <p class="label mt-1.5 flex flex-wrap gap-x-2 gap-y-1 text-fg">
          {impact.map((item, index) => (
            <span>
              {index > 0 && <span class="text-subtle" aria-hidden="true">· </span>}
              {item}
            </span>
          ))}
        </p>
      )
    }

    <p class="mt-3.5 max-w-2xl text-muted">{data.summary}</p>

    <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Key technologies">
      {tags.map((tag) => <li><Tag>{tag}</Tag></li>)}
    </ul>

    {
      isDraft && (
        <p class="mt-5 text-sm text-subtle">{linked ? 'Draft preview — not published' : 'Case study coming soon'}</p>
      )
    }
  </div>

  {
    data.coverDiagram && (
      <div class="order-first md:order-none md:col-span-3">
        <Image
          src={data.coverDiagram}
          alt={data.coverDiagramAlt ?? `Architecture diagram of ${data.title}`}
          width={480}
          loading="lazy"
          decoding="async"
          class="aspect-[16/10] w-full rounded-[2px] border border-line bg-surface object-cover"
        />
      </div>
    )
  }
</article>
