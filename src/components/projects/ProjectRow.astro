---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Tag from '@/components/ui/Tag.astro';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import { projectPath, type Project } from '@/lib/content';
import { formatIndex } from '@/lib/format';

interface Props {
  project: Project;
  /** Heading level of the project title. */
  as?: 'h2' | 'h3';
  /** Maximum number of focus tags to show. */
  maxTags?: number;
}

const { project, as: Heading = 'h3', maxTags = 5 } = Astro.props;
const { data } = project;
const tags = data.focus.slice(0, maxTags);
const remaining = data.focus.length - tags.length;
---

<article class="group relative grid gap-x-8 gap-y-4 border-b border-line py-9 transition-colors duration-200 md:grid-cols-9 lg:py-11">
  <p class="label pt-2 md:col-span-1">{formatIndex(data.order)}</p>

  <div class="md:col-span-7">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <Heading class="text-2xl tracking-tight sm:text-[1.75rem]">
        <a
          href={projectPath(project)}
          class="outline-none transition-colors duration-150 after:absolute after:inset-0 group-hover:text-accent focus-visible:text-accent focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-accent"
        >
          {data.title}
        </a>
      </Heading>
      {data.draft && <DraftBadge label="Case study in draft" />}
    </div>
    <p class="mt-3 max-w-2xl text-muted">{data.summary}</p>
    <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Technical focus">
      {tags.map((tag) => <li><Tag>{tag}</Tag></li>)}
      {remaining > 0 && <li><Tag>+{remaining}</Tag></li>}
    </ul>
  </div>

  <div class="hidden justify-end pt-2 md:col-span-1 md:flex">
    <ArrowUpRight
      class="size-5 text-subtle transition duration-200 ease-out-quart group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
      aria-hidden="true"
    />
  </div>
</article>
