---
/** Banner shown at the top of unpublished entries. */
interface Props {
  kind: 'case study' | 'insight' | 'system design study' | 'deep dive';
  /** Replaces the default explanation, e.g. for a complete draft awaiting review. */
  message?: string;
}

const { kind, message } = Astro.props;
---

<aside class="border border-dashed border-line-strong px-5 py-4 text-sm text-muted" aria-label="Draft notice">
  <p>
    <span class="label mr-3 text-fg">Draft</span>
    {
      message ??
        `This ${kind} is an unpublished outline. Sections marked “to be written” are placeholders, not finished content.`
    }
  </p>
</aside>
