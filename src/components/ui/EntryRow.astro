---
import DraftBadge from '@/components/ui/DraftBadge.astro';

/** Linked list row with a marker column: used for notes, studies and decision records. */
interface Props {
  href: string;
  title: string;
  description: string;
  /** Text for the left marker column when no `marker` slot is given. */
  marker?: string;
  /** Small line under the description. */
  meta?: string;
  draft?: boolean;
  draftLabel?: string;
  as?: 'h2' | 'h3';
}

const { href, title, description, marker, meta, draft = false, draftLabel, as: Heading = 'h3' } = Astro.props;
---

<article class="group relative grid gap-x-8 gap-y-2 border-b border-line py-7 md:grid-cols-9">
  <p class="label pt-1.5 md:col-span-2">
    <slot name="marker">{marker}</slot>
  </p>
  <div class="md:col-span-7">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <Heading class="text-xl leading-snug tracking-tight">
        <a
          href={href}
          class="outline-none transition-colors duration-150 after:absolute after:inset-0 group-hover:text-accent focus-visible:text-accent focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-accent"
        >
          {title}
        </a>
      </Heading>
      {draft && <DraftBadge label={draftLabel} />}
    </div>
    <p class="mt-2 max-w-2xl text-[0.9375rem] text-muted">{description}</p>
    {meta && <p class="label mt-4">{meta}</p>}
  </div>
</article>
