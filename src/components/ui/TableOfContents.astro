---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const headings = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{
  headings.length > 1 && (
    <nav aria-label="On this page">
      <p class="label">On this page</p>
      <ol class="mt-4 space-y-2.5 border-l border-line">
        {headings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class="-ml-px block border-l border-transparent pl-4 text-sm text-muted transition-colors hover:border-accent hover:text-fg"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
