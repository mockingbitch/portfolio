---
import EntryRow from '@/components/ui/EntryRow.astro';
import { getNoteCategory } from '@/data/noteCategories';
import { notePath, type Note } from '@/lib/content';
import { formatDate } from '@/lib/format';

interface Props {
  note: Note;
  as?: 'h2' | 'h3';
}

const { note, as = 'h3' } = Astro.props;
const { data } = note;
const published = !data.draft && data.pubDate ? data.pubDate : undefined;
---

<EntryRow
  href={notePath(note)}
  title={data.title}
  description={data.description}
  meta={getNoteCategory(data.category).label}
  draft={data.draft}
  as={as}
>
  <Fragment slot="marker">
    {published ? <time datetime={published.toISOString()}>{formatDate(published)}</time> : 'Unpublished'}
  </Fragment>
</EntryRow>
