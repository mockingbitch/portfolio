---
/** Row of link pills, used for category navigation. */
interface Props {
  label: string;
  items: { label: string; href: string; current: boolean }[];
}

const { label, items } = Astro.props;
---

<nav aria-label={label}>
  <ul class="flex flex-wrap gap-2">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[
              'inline-flex h-9 items-center border px-3.5 text-sm transition-colors duration-150',
              item.current ? 'border-fg bg-fg text-bg' : 'border-line text-muted hover:border-line-strong hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
