---
import { noteCategories } from '@/data/noteCategories';
import { noteCategoryPath } from '@/lib/content';

interface Props {
  /** Slug of the active category; omit for "All". */
  active?: string;
}

const { active } = Astro.props;
const items = [
  { label: 'All', href: '/notes/', current: active === undefined },
  ...noteCategories.map((category) => ({
    label: category.label,
    href: noteCategoryPath(category.slug),
    current: active === category.slug,
  })),
];
---

<nav aria-label="Note categories">
  <ul class="flex flex-wrap gap-2">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[
              'inline-flex h-9 items-center border px-3.5 text-sm transition-colors duration-150',
              item.current
                ? 'border-fg bg-fg text-bg'
                : 'border-line text-muted hover:border-line-strong hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
