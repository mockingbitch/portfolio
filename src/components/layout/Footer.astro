---
import { withBase } from '@/lib/url';
import { footerNavigation } from '@/data/navigation';
import { profile } from '@/data/profile';
import { social } from '@/data/social';

const year = new Date().getFullYear();
const linkClass = 'text-sm text-muted transition-colors hover:text-fg';
---

<footer class="border-t border-line">
  <div class="shell grid gap-x-8 gap-y-10 py-14 sm:grid-cols-2 lg:grid-cols-12">
    <div class="sm:col-span-2 lg:col-span-4">
      <p class="text-[0.9375rem] font-medium tracking-tight">{profile.name}</p>
      <p class="mt-2 max-w-xs text-sm text-muted">{profile.positioning.join(' · ')}</p>
    </div>

    {
      footerNavigation.map((group) => (
        <nav aria-label={group.title} class="lg:col-span-2">
          <p class="label">{group.title}</p>
          <ul class="mt-4 space-y-2.5">
            {group.items.map((item) => (
              <li>
                <a href={withBase(item.href)} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="lg:col-span-2">
      <p class="label">Elsewhere</p>
      <ul class="mt-4 space-y-2.5">
        {
          social.map((item) => (
            <li>
              <a href={item.href} class={linkClass} rel="me noopener">
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href={`mailto:${profile.email}`} class={linkClass}>Email</a></li>
        {
          profile.resume.href && (
            <li>
              <a href={withBase(profile.resume.href)} class={linkClass} download>
                {profile.resume.label}
              </a>
            </li>
          )
        }
        <li><a href={withBase('/rss.xml')} class={linkClass}>RSS</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="shell flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5">
      <p class="label">© {year} {profile.name}</p>
      <p class="label">Static by design</p>
    </div>
  </div>
</footer>
