---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NotesIndex from '@/components/articles/NotesIndex.astro';
import { noteCategories } from '@/data/noteCategories';
import { getNotes, type Note } from '@/lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return noteCategories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      notes: notes.filter((note) => note.data.category === category.slug),
    },
  }));
}

interface Props {
  category: (typeof noteCategories)[number];
  notes: Note[];
}

const { category, notes } = Astro.props;
const hasPublished = notes.some((note) => !note.data.draft);
---

<BaseLayout title={`${category.label} — Notes`} description={category.description} noindex={!hasPublished}>
  <NotesIndex notes={notes} title={category.label} lead={category.description} activeCategory={category.slug} />
</BaseLayout>
