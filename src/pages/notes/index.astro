---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NotesIndex from '@/components/articles/NotesIndex.astro';
import { getNotes } from '@/lib/content';

const notes = await getNotes();
const title = 'Notes on building and operating software systems.';
const lead =
  'Working notes on backend engineering, system architecture, infrastructure, security and the trade-offs between them.';
---

<BaseLayout title="Technical notes" description={lead}>
  <NotesIndex notes={notes} title={title} lead={lead} />
</BaseLayout>
