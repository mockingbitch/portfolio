---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import DiagramExplorer from '@/components/diagrams/DiagramExplorer.tsx';
import { diagrams } from '@/data/diagrams';
---

<BaseLayout
  title="Architecture playground"
  description="Interactive architecture and infrastructure diagrams: inspect components and step through request, identity and deployment flows."
>
  <PageHeader
    label="Playground"
    title="Explore the architecture, one component or one request at a time."
    lead="Each diagram is interactive. Select a component to see its responsibility and connections, or pick a flow to walk the path a request or a deployment takes."
  />

  <div class="shell pb-24 lg:pb-32">
    <DiagramExplorer client:load diagrams={diagrams} />

    <noscript>
      <div class="border-t border-line pt-10">
        <p class="max-w-2xl text-muted">The diagrams need JavaScript to be interactive. Their contents are listed below.</p>
        {
          diagrams.map((diagram) => (
            <section class="mt-10">
              <h2 class="text-xl tracking-tight">{diagram.title}</h2>
              <p class="mt-2 max-w-2xl text-muted">{diagram.summary}</p>
              <dl class="mt-6 grid gap-x-8 gap-y-5 md:grid-cols-2">
                {diagram.nodes.map((node) => (
                  <div>
                    <dt class="text-[0.9375rem] font-medium">{node.label}</dt>
                    <dd class="mt-1 text-sm text-muted">{node.description}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))
        }
      </div>
    </noscript>

    <div class="mt-14 border-t border-line pt-6">
      <ArrowLink href="/architecture/" direction="back">Architecture</ArrowLink>
    </div>
  </div>
</BaseLayout>
