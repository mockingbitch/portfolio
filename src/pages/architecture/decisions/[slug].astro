---
import { render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import Tag from '@/components/ui/Tag.astro';
import { mdxComponents } from '@/components/mdx';
import { decisionLabel, getDecisions, type Decision } from '@/lib/content';
import { formatDate } from '@/lib/format';

export async function getStaticPaths() {
  const decisions = await getDecisions();
  return decisions.map((decision) => ({ params: { slug: decision.id }, props: { decision } }));
}

interface Props {
  decision: Decision;
}

const { decision } = Astro.props;
const { data } = decision;
const { Content, headings } = await render(decision);
---

<ArticleLayout
  title={data.title}
  description={data.summary}
  back={{ href: '/architecture/#decisions', label: 'Architecture' }}
  headings={headings}
  draft={data.draft}
  draftKind="decision record"
  publishedTime={data.draft ? undefined : data.date}
>
  <Fragment slot="meta">
    <p class="label"><span class="text-accent">{decisionLabel(decision)}</span></p>
    <p class="label">Status — {data.status}</p>
    <p class="label"><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></p>
  </Fragment>
  <div slot="aside" class="space-y-10">
    <div>
      <h2 class="label">Scope</h2>
      <p class="mt-3 text-sm text-muted">{data.scope}</p>
    </div>
    {
      data.tags.length > 0 && (
        <div>
          <h2 class="label">Tags</h2>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {data.tags.map((tag) => (
              <li>
                <Tag>{tag}</Tag>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  <Content components={mdxComponents} />
</ArticleLayout>
