---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import Section from '@/components/layout/Section.astro';
import EntryList from '@/components/articles/EntryList.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import EntryRow from '@/components/ui/EntryRow.astro';
import { diagrams as allDiagrams } from '@/data/diagrams';
import { getSystemDesignStudies, publishedDate, systemDesignPath, withoutHiddenDrafts } from '@/lib/content';
import { formatDate, formatIndex } from '@/lib/format';

const studies = await getSystemDesignStudies();
const diagrams = withoutHiddenDrafts(allDiagrams);
---

<BaseLayout
  title="Architecture Lab"
  description="System design studies and interactive architecture diagrams: requirements, capacity, components, contracts, failure scenarios and trade-offs."
>
  <PageHeader
    label="Architecture Lab"
    title="System design, worked in the open."
    lead="Design problems taken from requirements and capacity estimates through architecture, contracts and schemas, to failure scenarios and trade-offs — with diagrams you can explore."
  />

  <Section
    id="playground"
    index="01"
    label="Playground"
    title="Interactive diagrams: select a component, or follow a request through the system."
  >
    <ol class="border-t border-line">
      {
        diagrams.map((diagram, index) => (
          <li class="grid gap-x-8 gap-y-2 border-b border-line py-6 md:grid-cols-9">
            <span class="label pt-1 md:col-span-1">{formatIndex(index + 1)}</span>
            <h3 class="text-lg leading-snug tracking-tight md:col-span-3">{diagram.title}</h3>
            <p class="text-[0.9375rem] text-muted md:col-span-5">{diagram.summary}</p>
          </li>
        ))
      }
    </ol>
    <ButtonLink href="/architecture/playground/" class="mt-10">Open the playground</ButtonLink>
  </Section>

  <Section
    id="system-design"
    index="02"
    label="System design"
    title="Design studies, each following the same thirteen steps."
  >
    <EntryList empty={studies.length === 0} emptyMessage="The first studies are being written. The playground above is live.">
      {
        studies.map((study) => {
          const published = publishedDate(study.data);
          return (
            <EntryRow
              href={systemDesignPath(study)}
              title={study.data.title}
              description={study.data.summary}
              marker={published ? formatDate(published) : 'Unpublished'}
              meta={study.data.topics.join(' · ')}
              draft={study.data.draft}
            />
          );
        })
      }
    </EntryList>
    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
      <ArrowLink href="/deep-dives/">Engineering deep dives</ArrowLink>
    </div>
  </Section>
</BaseLayout>
