---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import Contact from '@/components/sections/Contact.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import { leadership } from '@/data/leadership';
import { showDrafts } from '@/lib/content';
import { formatIndex } from '@/lib/format';
---

<BaseLayout
  title="Technical leadership"
  description="Approach to technical roadmaps, architecture governance, engineering standards, code review, technical debt, mentoring and cross-team collaboration."
>
  <PageHeader
    label="Leadership"
    title="Leading through clarity, standards and other people’s growth."
    lead="Technical leadership is mostly the work around the code: deciding what to build next, keeping decisions consistent, and making it easy for a team to do the right thing."
  />

  <div class="shell pb-24 lg:pb-32">
    <div class="border-t border-line" data-reveal-stagger>
      {
        leadership.map((area, index) => (
          <section
            id={area.id}
            aria-labelledby={`${area.id}-heading`}
            class="grid gap-x-8 gap-y-8 border-b border-line py-12 lg:grid-cols-12 lg:py-16"
          >
            <div class="lg:col-span-3">
              <p class="label">
                <span class="text-accent">{formatIndex(index + 1)}</span> / {formatIndex(leadership.length)}
              </p>
            </div>

            <div class="lg:col-span-4">
              <h2 id={`${area.id}-heading`} class="text-2xl tracking-tight">
                {area.title}
              </h2>
              <p class="mt-3 text-muted">{area.approach}</p>
            </div>

            <div class="lg:col-span-5">
              <h3 class="label">In practice</h3>
              <ul class="mt-4 border-t border-line">
                {area.practices.map((practice) => (
                  <li class="flex gap-4 border-b border-line py-3.5 text-[0.9375rem] text-muted">
                    <span class="text-subtle" aria-hidden="true">
                      —
                    </span>
                    <span>{practice}</span>
                  </li>
                ))}
              </ul>

              {area.record && area.record.length > 0 && (
                <>
                  <h3 class="label mt-8">Track record</h3>
                  <ul class="mt-4 border-t border-line">
                    {area.record.map((line) => (
                      <li class="flex gap-4 border-b border-line py-3.5 text-[0.9375rem]">
                        <span class="text-accent" aria-hidden="true">
                          →
                        </span>
                        <span>{line}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}

              {area.evidence && area.evidence.length > 0 ? (
                <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
                  <h3 class="label">Evidence</h3>
                  {area.evidence.map((item) => (
                    <ArrowLink href={item.href}>{item.label}</ArrowLink>
                  ))}
                </div>
              ) : (
                showDrafts &&
                !area.record?.length && (
                  <div class="mt-6">
                    <DraftBadge label="Examples to be added" />
                  </div>
                )
              )}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <Contact />
</BaseLayout>
