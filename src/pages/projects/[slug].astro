---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import DraftNotice from '@/components/ui/DraftNotice.astro';
import { mdxComponents } from '@/components/mdx';
import Prose from '@/components/ui/Prose.astro';
import TableOfContents from '@/components/ui/TableOfContents.astro';
import Tag from '@/components/ui/Tag.astro';
import { getProjects, projectPath, type Project } from '@/lib/content';
import { formatIndex } from '@/lib/format';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      total: projects.length,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  total: number;
  next: Project | undefined;
}

const { project, total, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

const meta = [
  { label: 'Role', value: data.role },
  { label: 'Status', value: data.status },
  { label: 'Period', value: data.period },
];
---

<BaseLayout title={data.title} description={data.summary} type="article" noindex={data.draft}>
  <article>
    <header class="shell pb-14 pt-12 lg:pb-20 lg:pt-16">
      <ArrowLink href="/projects/" direction="back">All work</ArrowLink>

      <div class="mt-12 grid gap-x-8 gap-y-6 lg:mt-16 lg:grid-cols-12">
        <p class="label rise lg:col-span-3">
          <span class="text-accent">{formatIndex(data.order)}</span>
          <span> / {formatIndex(total)}</span>
        </p>
        <div class="lg:col-span-9">
          <h1 class="rise text-title" style="--rise-step: 1">{data.title}</h1>
          <p class="rise mt-6 max-w-2xl text-lead text-muted" style="--rise-step: 2">{data.summary}</p>
        </div>
      </div>
    </header>

    <div class="border-y border-line">
      <div class="shell grid gap-x-8 lg:grid-cols-12">
        <dl class="grid gap-px bg-line sm:grid-cols-3 lg:col-span-9 lg:col-start-4">
          {
            meta.map((item) => (
              <div class="bg-bg py-6 sm:px-6 sm:first:pl-0">
                <dt class="label">{item.label}</dt>
                <dd class:list={['mt-2 text-[0.9375rem]', !item.value && 'text-subtle']}>
                  {item.value ?? 'To be added'}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="shell grid gap-x-8 gap-y-12 py-16 lg:grid-cols-12 lg:py-24">
      <aside class="space-y-10 lg:col-span-3">
        <div class="space-y-10 lg:sticky lg:top-24">
          <TableOfContents headings={headings} />
          <div>
            <h2 class="label">Technical focus</h2>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {data.focus.map((item) => <li><Tag>{item}</Tag></li>)}
            </ul>
          </div>
          {
            data.links.length > 0 && (
              <div>
                <h2 class="label">Links</h2>
                <ul class="mt-4 space-y-2.5">
                  {data.links.map((link) => (
                    <li>
                      <ArrowLink href={link.href}>{link.label}</ArrowLink>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </aside>

      <div class="min-w-0 lg:col-span-9">
        {
          data.draft && (
            <div class="mb-12 max-w-[44rem]">
              <DraftNotice kind="case study" />
            </div>
          )
        }
        <Prose>
          <Content components={mdxComponents} />
        </Prose>
      </div>
    </div>
  </article>

  {
    next && next.id !== project.id && (
      <nav aria-label="Next project" class="border-t border-line">
        <a href={projectPath(next)} class="group block">
          <div class="shell grid gap-x-8 gap-y-3 py-14 lg:grid-cols-12 lg:py-20">
            <p class="label lg:col-span-3">Next — {formatIndex(next.data.order)}</p>
            <p class="text-title transition-colors duration-150 group-hover:text-accent lg:col-span-9">
              {next.data.title}
            </p>
          </div>
        </a>
      </nav>
    )
  }
</BaseLayout>
