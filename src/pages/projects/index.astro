---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import ProjectRow from '@/components/projects/ProjectRow.astro';
import CallToAction from '@/components/sections/CallToAction.astro';
import Tag from '@/components/ui/Tag.astro';
import { clientWork } from '@/data/clientWork';
import { projectGroups } from '@/data/projectGroups';
import { getProjects } from '@/lib/content';

const projects = await getProjects();
const total = projects.length + clientWork.length;

// Each project and engagement has exactly one group, so these counts sum to the total.
const filters = [
  { id: '', label: 'All', count: total },
  ...projectGroups
    .map((group) => ({
      id: group.id as string,
      label: group.label as string,
      count:
        projects.filter((project) => project.data.group === group.id).length +
        clientWork.filter((item) => item.group === group.id).length,
    }))
    .filter((filter) => filter.count > 0),
];

// The intro only promises case studies that actually exist.
const published = projects.filter((project) => project.data.status === 'published').length;
const lead =
  published === 0
    ? 'Systems I have designed, built and run, with my role, the period and the stack for each. Full case studies are being written and will be linked here as they are published.'
    : published === projects.length
      ? 'Each project links to a full case study: context, requirements, architecture, data and API design, security, scalability, reliability and the trade-offs accepted along the way.'
      : `${published} of ${projects.length} projects ${published === 1 ? 'links' : 'link'} to a full case study covering architecture, data and API design, security, reliability and trade-offs. The rest are in progress.`;

const filterButton = [
  // Chips below lg …
  'inline-flex h-9 items-center gap-2 border border-line px-3.5 text-sm text-muted transition-colors duration-150',
  'hover:border-line-strong hover:text-fg aria-pressed:border-fg aria-pressed:bg-fg aria-pressed:text-bg',
  // … a vertical list from lg up.
  'lg:flex lg:h-auto lg:w-full lg:justify-between lg:border-0 lg:border-l lg:px-4 lg:py-2 lg:text-left',
  'lg:hover:border-line-strong lg:aria-pressed:border-accent lg:aria-pressed:bg-transparent lg:aria-pressed:text-fg',
].join(' ');
---

<BaseLayout
  title="Projects & case studies"
  description="Projects across AI agent platforms, payments, commerce, product platforms and production infrastructure, with role, period and stack for each."
>
  <PageHeader label="Projects" title="Systems designed, built and operated." lead={lead} />

  <div class="shell pb-24 lg:pb-32">
    <div class="grid gap-x-8 gap-y-8 lg:grid-cols-12">
      <aside class="lg:col-span-3">
        <div class="lg:sticky lg:top-24">
          <h2 class="label mb-4" id="filter-heading">Filter</h2>
          <div
            role="group"
            aria-labelledby="filter-heading"
            class="flex flex-wrap gap-2 lg:block lg:space-y-0.5 lg:pr-8"
            data-project-filter
          >
            {
              filters.map((filter) => (
                <button type="button" class={filterButton} aria-pressed={filter.id === ''} data-filter={filter.id}>
                  <span>{filter.label}</span>
                  <span class="font-mono text-xs" aria-hidden="true">
                    {filter.count}
                  </span>
                  <span class="sr-only">
                    , {filter.count} {filter.count === 1 ? 'project' : 'projects'}
                  </span>
                </button>
              ))
            }
          </div>
          <p class="label mt-6" role="status" aria-live="polite" data-project-count>
            {total} projects
          </p>
        </div>
      </aside>

      <div class="lg:col-span-9">
        <div class="border-t border-line" data-project-list data-reveal-stagger>
          {projects.map((project) => <ProjectRow project={project} as="h2" />)}
        </div>

        <section aria-labelledby="client-work-heading" class="mt-20 lg:mt-28" data-client-section>
          <p class="label">Earlier client work</p>
          <h2 id="client-work-heading" class="mt-5 max-w-3xl text-heading">
            Enterprise systems for clients in Japan, the United States and Vietnam.
          </h2>
          <ol class="mt-10 border-t border-line lg:mt-14" data-reveal-stagger>
            {
              clientWork.map((item) => (
                <li class="grid gap-x-8 gap-y-2 border-b border-line py-7 md:grid-cols-9" data-project data-group={item.group}>
                  <p class="label pt-1.5 md:col-span-2">{item.period}</p>
                  <div class="md:col-span-7">
                    <h3 class="text-xl leading-snug tracking-tight">{item.name}</h3>
                    <p class="label mt-2">
                      {item.role} · {item.client} · Team of {item.teamSize}
                    </p>
                    <p class="mt-3 max-w-2xl text-[0.9375rem] text-muted">{item.description}</p>
                    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technology stack">
                      {item.stack.map((tag) => (
                        <li>
                          <Tag>{tag}</Tag>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </div>
  </div>

  <CallToAction />
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter] button'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-project-list], [data-client-section]'));
  const count = document.querySelector<HTMLElement>('[data-project-count]');
  const known = new Set(buttons.map((button) => button.dataset.filter ?? ''));

  /** Show the rows of one group ('' = all), and keep buttons, counter and URL in step. */
  const apply = (group: string, updateUrl: boolean) => {
    let visible = 0;
    for (const row of rows) {
      const match = !group || row.dataset.group === group;
      row.hidden = !match;
      if (match) visible += 1;
    }
    // Hide a whole section, heading included, when none of its rows match.
    for (const section of sections) {
      section.hidden = !section.querySelector('[data-project]:not([hidden])');
    }
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String((button.dataset.filter ?? '') === group));
    }
    if (count) count.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (group) url.searchParams.set('group', group);
      else url.searchParams.delete('group');
      window.history.replaceState(null, '', url);
    }
  };

  for (const button of buttons) {
    button.addEventListener('click', () => apply(button.dataset.filter ?? '', true));
  }

  // Restore the filter from a shared or reloaded URL.
  const initial = new URLSearchParams(window.location.search).get('group') ?? '';
  if (initial && known.has(initial)) apply(initial, false);
</script>
