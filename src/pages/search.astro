---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
---

<BaseLayout
  title="Search"
  description="Search projects, system design studies, deep dives and insights."
>
  <PageHeader label="Search" title="Search the technical content.">
    <form role="search" class="rise mt-10 max-w-2xl" style="--rise-step: 2" data-search-form>
      <label for="search-input" class="label">Projects, designs, deep dives and insights</label>
      <input
        id="search-input"
        name="q"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="e.g. mTLS, scheduler, PostgreSQL"
        class="mt-3 block w-full border-0 border-b border-line-strong bg-transparent px-0 py-3 text-xl tracking-tight text-fg placeholder:text-subtle focus:border-accent focus:outline-none"
      />
    </form>
  </PageHeader>

  <div class="shell pb-24 lg:pb-32">
    <div class="grid gap-x-8 lg:grid-cols-12">
      <div class="lg:col-span-9 lg:col-start-4">
        <p class="label" role="status" aria-live="polite" data-search-status>Type to search.</p>
        <ol class="mt-5" data-search-results></ol>
        <noscript>
          <p class="mt-6 text-muted">Search needs JavaScript. All content is also reachable from the navigation.</p>
        </noscript>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import type { SearchEntry } from '@/lib/search';

  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const results = document.querySelector<HTMLOListElement>('[data-search-results]');

  let index: Promise<SearchEntry[]> | undefined;
  const load = () => (index ??= fetch(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/search.json`).then((response) => response.json() as Promise<SearchEntry[]>));

  const element = (tag: string, className: string, text?: string) => {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  function rank(entries: SearchEntry[], query: string) {
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (terms.length === 0) return [];
    return entries
      .flatMap((entry) => {
        const title = entry.title.toLowerCase();
        const tags = entry.tags.join(' ').toLowerCase();
        const description = entry.description.toLowerCase();
        const text = entry.text.toLowerCase();
        let score = 0;
        for (const term of terms) {
          const hit =
            (title.includes(term) ? 8 : 0) +
            (tags.includes(term) ? 4 : 0) +
            (description.includes(term) ? 2 : 0) +
            (text.includes(term) ? 1 : 0);
          if (hit === 0) return [];
          score += hit;
        }
        return [{ entry, score }];
      })
      .sort((a, b) => b.score - a.score)
      .map((item) => item.entry);
  }

  function render(matches: SearchEntry[], query: string) {
    if (!results || !status) return;
    results.replaceChildren();
    results.classList.toggle('border-t', matches.length > 0);
    results.classList.toggle('border-line', matches.length > 0);

    if (!query.trim()) {
      status.textContent = 'Type to search.';
      return;
    }
    status.textContent = matches.length === 0 ? `No results for “${query}”.` : `${matches.length} ${matches.length === 1 ? 'result' : 'results'}`;

    for (const match of matches) {
      const item = element('li', 'border-b border-line');
      const link = element('a', 'group grid gap-x-8 gap-y-1.5 py-6 md:grid-cols-9') as HTMLAnchorElement;
      link.href = match.url;

      link.append(element('span', 'label pt-1 md:col-span-2', match.type));
      const body = element('span', 'block md:col-span-7');
      const heading = element('span', 'flex flex-wrap items-center gap-x-4 gap-y-1');
      heading.append(
        element('span', 'text-lg leading-snug tracking-tight transition-colors duration-150 group-hover:text-accent', match.title),
      );
      if (match.draft) {
        heading.append(
          element(
            'span',
            'border border-dashed border-line-strong px-2 py-1 font-mono text-[0.6875rem] uppercase leading-none tracking-[0.06em] text-subtle',
            'Draft',
          ),
        );
      }
      body.append(heading, element('span', 'mt-1.5 block max-w-2xl text-[0.9375rem] text-muted', match.description));
      link.append(body);
      item.append(link);
      results.append(item);
    }
  }

  async function run() {
    if (!input || !status) return;
    const query = input.value;
    const url = new URL(window.location.href);
    if (query.trim()) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    window.history.replaceState(null, '', url);

    try {
      render(rank(await load(), query), query);
    } catch {
      status.textContent = 'Search is unavailable right now.';
    }
  }

  if (form && input) {
    form.addEventListener('submit', (event) => event.preventDefault());
    input.addEventListener('input', () => void run());
    input.addEventListener('focus', () => void load().catch(() => undefined), { once: true });

    const initial = new URLSearchParams(window.location.search).get('q');
    if (initial) {
      input.value = initial;
      void run();
    }
  }
</script>
