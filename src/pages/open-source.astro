---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import Contact from '@/components/sections/Contact.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import { openSource } from '@/data/openSource';
import { social } from '@/data/social';
import { withoutHiddenPlaceholders } from '@/lib/content';

const entries = withoutHiddenPlaceholders(openSource);
const github = social.find((item) => item.label === 'GitHub');
---

<BaseLayout
  title="Open source"
  description="Open-source libraries, technical tools and contributions to other projects."
>
  <PageHeader
    label="Open source"
    title="Libraries, tools and contributions in the open."
    lead="Work that can be read, run and verified: projects I maintain and changes I have contributed upstream."
  >
    {
      github && (
        <div class="mt-8">
          <ArrowLink href={github.href}>Repositories and activity on GitHub</ArrowLink>
        </div>
      )
    }
  </PageHeader>

  <div class="shell pb-24 lg:pb-32">
    <div class="grid gap-x-8 lg:grid-cols-12">
      <div class="lg:col-span-9 lg:col-start-4">
        {
          entries.length > 0 ? (
            <ul class="border-t border-line">
              {entries.map((entry) => (
                <li class="grid gap-x-8 gap-y-2 border-b border-line py-7 md:grid-cols-9">
                  <p class="label pt-1.5 md:col-span-2">{entry.kind}</p>
                  <div class="md:col-span-7">
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                      <h2 class="font-mono text-lg leading-snug tracking-tight">
                        {entry.url ? (
                          <a href={entry.url} rel="noopener" class="link">
                            {entry.project}
                          </a>
                        ) : (
                          entry.project
                        )}
                      </h2>
                      {entry.placeholder && <DraftBadge label="Placeholder" />}
                    </div>
                    <p class:list={['mt-2 max-w-2xl text-[0.9375rem]', entry.placeholder ? 'text-subtle' : 'text-muted']}>
                      {entry.description}
                    </p>
                    {entry.contributions && entry.contributions.length > 0 && (
                      <ul class="mt-4 space-y-1.5 text-[0.9375rem] text-muted">
                        {entry.contributions.map((contribution) => (
                          <li class="flex gap-3">
                            <span class="text-subtle" aria-hidden="true">
                              —
                            </span>
                            {contribution.url ? (
                              <a href={contribution.url} rel="noopener" class="link">
                                {contribution.title}
                              </a>
                            ) : (
                              <span>{contribution.title}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                    {entry.language && <p class="label mt-4">{entry.language}</p>}
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="border-y border-line py-10 text-muted">A curated list is being prepared. In the meantime, my repositories are on GitHub.</p>
          )
        }
      </div>
    </div>
  </div>

  <Contact />
</BaseLayout>
