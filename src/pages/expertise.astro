---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import { domains, type DomainId } from '@/data/expertise';
import {
  deepDivePath,
  getDeepDives,
  getProjects,
  projectHasPage,
  getSystemDesignStudies,
  projectPath,
  systemDesignPath,
} from '@/lib/content';
import { formatIndex } from '@/lib/format';

const [projects, studies, deepDives] = await Promise.all([getProjects(), getSystemDesignStudies(), getDeepDives()]);

interface Evidence {
  kind: string;
  title: string;
  /** Undefined when the entry has no page in this build (a project whose case study is not published). */
  href?: string;
  draft: boolean;
}

/** Everything on the site that lists this domain in its frontmatter. */
function evidenceFor(id: DomainId): Evidence[] {
  return [
    ...projects
      .filter((entry) => entry.data.domains.includes(id))
      .map((entry) => ({
        kind: 'Project',
        title: entry.data.title,
        href: projectHasPage(entry) ? projectPath(entry) : undefined,
        draft: entry.data.status === 'draft',
      })),
    ...studies
      .filter((entry) => entry.data.domains.includes(id))
      .map((entry) => ({ kind: 'System design', title: entry.data.title, href: systemDesignPath(entry), draft: entry.data.draft })),
    ...deepDives
      .filter((entry) => entry.data.domains.includes(id))
      .map((entry) => ({ kind: 'Deep dive', title: entry.data.title, href: deepDivePath(entry), draft: entry.data.draft })),
  ];
}
---

<BaseLayout
  title="Technical expertise"
  description="Technical expertise organised by engineering domain, each backed by the projects, system designs and deep dives that demonstrate it."
>
  <PageHeader
    label="Expertise"
    title="Expertise by engineering domain, shown through the work."
    lead="No skill bars and no percentages. Each domain lists the technologies I use and links to the projects, designs and write-ups where they were applied."
  />

  <div class="shell pb-24 lg:pb-32">
    <nav aria-label="Domains" class="mb-12 grid gap-x-8 lg:grid-cols-12">
      <ul class="flex flex-wrap gap-2 lg:col-span-9 lg:col-start-4">
        {
          domains.map((domain) => (
            <li>
              <a
                href={`#${domain.id}`}
                class="inline-flex h-9 items-center border border-line px-3.5 text-sm text-muted transition-colors duration-150 hover:border-line-strong hover:text-fg"
              >
                {domain.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="border-t border-line" data-reveal-stagger>
      {
        domains.map((domain, index) => {
          const evidence = evidenceFor(domain.id);
          return (
            <section
              id={domain.id}
              aria-labelledby={`${domain.id}-heading`}
              class="grid gap-x-8 gap-y-8 border-b border-line py-12 lg:grid-cols-12 lg:py-16"
            >
              <div class="lg:col-span-3">
                <p class="label">
                  <span class="text-accent">{formatIndex(index + 1)}</span> / {formatIndex(domains.length)}
                </p>
              </div>

              <div class="lg:col-span-4">
                <h2 id={`${domain.id}-heading`} class="text-2xl tracking-tight">
                  {domain.title}
                </h2>
                <p class="mt-3 text-[0.9375rem] text-muted">{domain.summary}</p>
                <ul class="mt-6 space-y-1.5 border-t border-line pt-5 font-mono text-[0.8125rem] text-muted">
                  {domain.technologies.map((item) => <li>{item}</li>)}
                </ul>
              </div>

              <div class="lg:col-span-5">
                <h3 class="label">Evidence</h3>
                {evidence.length > 0 ? (
                  <ul class="mt-4 border-t border-line">
                    {evidence.map((item) => {
                      const Row = item.href ? 'a' : 'div';
                      return (
                        <li>
                          <Row
                            href={item.href}
                            class="group flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line py-3.5"
                          >
                            <span class="label w-28 shrink-0">{item.kind}</span>
                            <span
                              class:list={[
                                'text-[0.9375rem]',
                                item.href && 'transition-colors duration-150 group-hover:text-accent',
                              ]}
                            >
                              {item.title}
                            </span>
                            {item.draft && item.href && (
                              <span class="ml-auto">
                                <DraftBadge />
                              </span>
                            )}
                          </Row>
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <p class="mt-4 border-y border-line py-3.5 text-[0.9375rem] text-muted">
                    Case studies for this domain are being prepared.
                  </p>
                )}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
