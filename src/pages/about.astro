---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import Section from '@/components/layout/Section.astro';
import Principles from '@/components/sections/Principles.astro';
import ExperienceList from '@/components/sections/ExperienceList.astro';
import Contact from '@/components/sections/Contact.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import { domains } from '@/data/expertise';
import { education, experience } from '@/data/experience';
import { philosophy } from '@/data/philosophy';
import { portrait } from '@/data/portrait';
import { profile } from '@/data/profile';
import { withoutHiddenPlaceholders } from '@/lib/content';
import { formatIndex } from '@/lib/format';

const experienceEntries = withoutHiddenPlaceholders(experience);

let section = 0;
const nextIndex = () => formatIndex(++section);
---

<BaseLayout
  title="About"
  description="Professional profile, engineering philosophy, areas of specialization, career progression and approach to technical leadership."
>
  <PageHeader label="About" title={philosophy.lead}>
    <div slot="aside" class="rise mt-8 max-w-[15rem]" style="--rise-step: 1">
      <Image
        src={portrait.image}
        alt={portrait.alt}
        width={480}
        height={600}
        fit="cover"
        position="top"
        loading="eager"
        class="aspect-[4/5] w-full rounded-[2px] object-cover"
      />
      <p class="mt-4 text-[0.9375rem] font-medium tracking-tight">{profile.name}</p>
      <p class="label mt-1.5">{profile.positioning[0]}</p>
      {profile.location && <p class="label mt-1.5">{profile.location}</p>}
    </div>
    <p class="rise mt-8 max-w-2xl text-lead text-muted" style="--rise-step: 2">{profile.summary}</p>
    <div class="rise mt-8 grid max-w-4xl gap-x-8 gap-y-5 text-muted md:grid-cols-2" style="--rise-step: 3">
      {philosophy.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </PageHeader>

  <Section
    id="philosophy"
    index={nextIndex()}
    label="Philosophy"
    title="Five ideas that shape most of my engineering decisions."
  >
    <Principles items={philosophy.principles} />
  </Section>

  <Section
    id="specialization"
    index={nextIndex()}
    label="Specialization"
    title="Where I go deep, and the technologies I use to do it."
  >
    <dl class="border-t border-line">
      {
        domains.map((domain) => (
          <div class="grid gap-x-8 gap-y-2 border-b border-line py-5 md:grid-cols-9">
            <dt class="text-[0.9375rem] font-medium tracking-tight md:col-span-3">
              <a href={`/expertise/#${domain.id}`} class="transition-colors hover:text-accent">
                {domain.title}
              </a>
            </dt>
            <dd class="font-mono text-[0.8125rem] leading-6 text-muted md:col-span-6">
              {domain.technologies.join('  ·  ')}
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-10">
      <ArrowLink href="/expertise/">Expertise, with the work behind it</ArrowLink>
    </div>
  </Section>

  <Section
    id="interests"
    index={nextIndex()}
    label="Technical interests"
    title="The problems I keep coming back to."
  >
    <Principles items={philosophy.interests} />
  </Section>

  {
    experienceEntries.length > 0 && (
      <Section
        id="career"
        index={nextIndex()}
        label="Career progression"
        title="Roles, scope and the systems behind them."
      >
        <ExperienceList entries={experienceEntries} detailed />

        <h3 class="label mt-14">Education</h3>
        <ul class="mt-5 border-t border-line">
          {education.map((entry) => (
            <li class="grid gap-x-8 gap-y-2 border-b border-line py-6 md:grid-cols-9">
              <p class="label pt-1 md:col-span-2">{entry.period}</p>
              <div class="md:col-span-7">
                <p class="text-lg leading-snug tracking-tight">{entry.qualification}</p>
                <p class="label mt-2">{entry.institution}</p>
              </div>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section
    id="collaboration"
    index={nextIndex()}
    label="Leadership & collaboration"
    title="How I work with the people around the system."
  >
    <Principles items={philosophy.collaboration} />
    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
      <ArrowLink href="/leadership/">Technical leadership in practice</ArrowLink>
      <ArrowLink href="/open-source/">Open-source work</ArrowLink>
    </div>
  </Section>

  <Contact index={nextIndex()} />
</BaseLayout>
